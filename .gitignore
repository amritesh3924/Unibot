# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual Environment
venv/
env/
ENV/

# Environment variables
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Database files
*.db
*.db-shm
*.db-wal
memory.db*

# ChromaDB (old Gemini-embedding backup - superseded, too large/stale to commit)
chroma_db/
**/chroma_db/

# Vector DB internals are excluded by extension below, EXCEPT inside
# chroma_db_fastembed/ - that one IS committed on purpose. It's the
# pre-built knowledge base the deployed app serves from, so the app
# doesn't depend on re-scraping/re-embedding or a persistent disk at
# deploy time.
*.sqlite3
*.bin
!chroma_db_fastembed/**/*.sqlite3
!chroma_db_fastembed/**/*.bin

# FastEmbed model cache - baked into the Docker image at build time
# instead (see Dockerfile), not committed to the repo.
fastembed_cache/
*.pickle

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Scrape tracker and checkpoint files (runtime data)
scrape_tracker.json
scrape_checkpoint.json

# Sandbox directory (for file operations)
sandbox/

# Node.js / React
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.log

# Test/dev-only scripts and archives - not part of the app
test_playwright.py
test_scraper.py
index_bmsit.py
*.zip